description:{ 
    label: 'Items Purchase Orders',
    type: #STANDARD,
    value:'Material',
    criticality: 'ProductPrice'
},

title.value: 'ShortText'

}
annotate entity ZC_PurchaseItems_Quantity
    with 
{
@UI.facet: [{ 


  id: 'coll2',
  type: #COLLECTION,
  position: 10,
  label: 'Item detail',
  purpose: #STANDARD
 },
 { 
         id: 'BasicInfo',
        purpose: #STANDARD,
        parentId: 'coll2',
        position: 10,
        targetQualifier: 'ItemData',
        type: #FIELDGROUP_REFERENCE,
        label: 'Item Info'
 
 },
 
  { 
         id: 'BasicInfo2',
        purpose: #STANDARD,
        parentId: 'coll2',
        position: 20,
